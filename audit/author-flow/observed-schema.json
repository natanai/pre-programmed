{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed Author UI state-transition graph",
  "description": "Only populated by actual UI execution against a named test fixture. Never infer a transition from an AST handler or an author intention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "provenance",
    "fixtures",
    "states",
    "transitions",
    "frontier"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "author-observed-transitions"
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "runtime_executed"
      ],
      "properties": {
        "method": {
          "const": "browser-observation"
        },
        "runtime_executed": {
          "const": true
        },
        "source_commit": {
          "type": "string"
        },
        "recorder_version": {
          "type": "string"
        },
        "initial_state_id": {
          "type": "string"
        },
        "explorer": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": [
                "breadth",
                "stratified"
              ]
            },
            "suite": {
              "type": "string"
            },
            "maxStates": {
              "type": "integer"
            },
            "maxDepth": {
              "type": "integer"
            },
            "maxExecutions": {
              "type": "integer"
            },
            "enableScroll": {
              "type": "boolean"
            },
            "scrollMechanism": {
              "enum": [
                "none",
                "wheel"
              ]
            }
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "project_fixture",
          "viewport",
          "initial_run"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_fixture": {
            "type": "string"
          },
          "project_sha256": {
            "type": "string"
          },
          "viewport": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            }
          },
          "initial_run": {
            "type": "object"
          },
          "clock": {
            "type": "string"
          },
          "seed": {
            "type": [
              "number",
              "string"
            ]
          },
          "input_domain": {
            "type": "object",
            "required": [
              "kind",
              "case_id",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "case_id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "navigation_case": {
            "enum": [
              "close-keep-discard",
              "close-save-all",
              "nested-parent-return",
              "dirty-child-back"
            ]
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fixture",
          "ui",
          "task_stack",
          "draft_state",
          "run_state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "ui": {
            "type": "object",
            "required": [
              "visible_controls"
            ],
            "properties": {
              "visible_controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "locator",
                    "kind",
                    "enabled"
                  ],
                  "properties": {
                    "locator": {
                      "type": "string"
                    },
                    "source_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "enabled"
                        ],
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          },
                          "enabled": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "scrollable_regions": {
                "type": "array",
                "description": "Actual pointer-reachable overflow-y scroll containers with observed scroll offsets and finite scroll extents.",
                "items": {
                  "type": "object",
                  "required": [
                    "locator",
                    "axis",
                    "top",
                    "max_top",
                    "client_height"
                  ],
                  "properties": {
                    "locator": {
                      "type": "string"
                    },
                    "axis": {
                      "const": "y"
                    },
                    "top": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_top": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "client_height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "task_stack": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "draft_state": {
            "type": "object"
          },
          "run_state": {
            "type": "object"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fixture",
          "from",
          "to",
          "action",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "required": [
              "locator",
              "event",
              "value"
            ],
            "properties": {
              "locator": {
                "type": "string"
              },
              "event": {
                "enum": [
                  "click",
                  "change",
                  "submit",
                  "key",
                  "toggle",
                  "scroll",
                  "fill"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "pointer_activations": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "observed": {
            "const": true
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "persistence": {
            "type": "object",
            "description": "Evidence-only canonical Save outcome, checked by reading the disposable local D1 project before and after a Worker restart.",
            "required": [
              "source",
              "node_id",
              "field",
              "prior_value",
              "expected_value",
              "readback_value",
              "revision_before",
              "revision_after",
              "snapshot_sha256_before",
              "snapshot_sha256_after",
              "restart_verified",
              "restart_snapshot_sha256"
            ],
            "properties": {
              "source": {
                "const": "local-d1-readback"
              },
              "node_id": {
                "type": "string"
              },
              "field": {
                "const": "openings[0].narrationText"
              },
              "prior_value": {
                "type": "string"
              },
              "expected_value": {
                "type": "string"
              },
              "readback_value": {
                "type": "string"
              },
              "revision_before": {
                "type": "integer"
              },
              "revision_after": {
                "type": "integer"
              },
              "snapshot_sha256_before": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "snapshot_sha256_after": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "restart_verified": {
                "const": true
              },
              "restart_snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "project_observation": {
            "type": "object",
            "description": "D1 readback and exact post-restart persisted project verification after an actual close/back/Save All UI transition.",
            "required": [
              "source",
              "case_id",
              "field",
              "node_id",
              "expected_value",
              "readback_value",
              "revision_before",
              "revision_after",
              "snapshot_sha256_before",
              "snapshot_sha256_after",
              "changed",
              "restart_verified",
              "restart_snapshot_sha256"
            ],
            "properties": {
              "source": {
                "const": "local-d1-readback"
              },
              "case_id": {
                "type": "string"
              },
              "field": {
                "const": "openings[0].narrationText"
              },
              "node_id": {
                "type": "string"
              },
              "expected_value": {
                "type": "string"
              },
              "readback_value": {
                "type": "string"
              },
              "revision_before": {
                "type": "integer"
              },
              "revision_after": {
                "type": "integer"
              },
              "snapshot_sha256_before": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "snapshot_sha256_after": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "changed": {
                "type": "boolean"
              },
              "restart_verified": {
                "const": true
              },
              "restart_snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "draft_observation": {
            "type": "object",
            "description": "DOM-observed draft field after returning from an actual nested task, before any persistent Save.",
            "required": [
              "kind",
              "field",
              "expected_value",
              "observed_value"
            ],
            "properties": {
              "kind": {
                "const": "resumed-parent"
              },
              "field": {
                "const": "openings[0].narrationText"
              },
              "expected_value": {
                "type": "string"
              },
              "observed_value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "frontier": {
      "type": "array",
      "description": "Explicit non-observed branches; no branch may be silently called covered.",
      "items": {
        "type": "object",
        "required": [
          "state",
          "locator",
          "reason"
        ],
        "properties": {
          "state": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "unvisited",
              "unbounded-input",
              "requires-fixture",
              "async-external",
              "unsafe-mutation",
              "unknown"
            ]
          },
          "action": {
            "type": "object",
            "required": [
              "locator",
              "event",
              "value"
            ],
            "properties": {
              "locator": {
                "type": "string"
              },
              "event": {
                "enum": [
                  "click",
                  "change",
                  "submit",
                  "key",
                  "toggle",
                  "scroll",
                  "fill"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "pointer_activations": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "replays": {
      "type": "array",
      "description": "Contiguous observed paths in individual browser sessions; unlike edges merged on visible state fingerprints, these paths are safe to compose in sequence.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fixture",
          "initial_state",
          "steps",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "initial_state": {
            "type": "string"
          },
          "completed": {
            "const": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "action"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "action": {
                  "type": "object",
                  "required": [
                    "locator",
                    "event",
                    "value"
                  ],
                  "properties": {
                    "locator": {
                      "type": "string"
                    },
                    "event": {
                      "enum": [
                        "click",
                        "change",
                        "toggle",
                        "submit",
                        "key",
                        "scroll",
                        "fill"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "pointer_activations": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
