{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "worker",
    "src/game/model.ts",
    "src/game/inventory.ts",
    "src/engine/**/*.ts",
    "src/features/**/*.ts"
  ],
  "exclude": [
    "src/features/**/author/**",
    "src/features/**/ui/**"
  ]
}
