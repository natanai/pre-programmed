# Optional hosted API override.
# The bundled production workflow normally captures this installation's Worker
# URL from Wrangler and injects it into the client build automatically.
# Set VITE_API_ORIGIN when using a custom API domain or a different deployment flow.
VITE_API_ORIGIN=https://your-api.example.com

# GitHub Pages/project subpath for a fork or renamed repository.
# Keep leading and trailing slashes.
VITE_BASE_PATH=/your-repository-name/
