{
  "name": "pre-programmed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "npm run build && vite preview",
    "deploy": "npm run typecheck && wrangler deploy",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  }
}
