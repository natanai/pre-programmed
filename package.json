{
  "name": "pre-programmed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:assets": "node scripts/generate-asset-manifest.mjs",
    "setup:installation": "node scripts/setup-installation.mjs",
    "predev": "npm run generate:assets",
    "dev": "vite",
    "prebuild": "npm run generate:assets",
    "build": "tsc -b && vite build",
    "prebuild:pages": "npm run generate:assets",
    "build:pages": "tsc -b && vite build --mode pages",
    "pretypecheck": "npm run generate:assets",
    "typecheck": "tsc -b",
    "pretest": "npm run generate:assets",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "4.127.1"
  }
}
